{
  // Project-wide markdown rules. Run with: npx markdownlint-cli2 "**/*.md"
  "config": {
    // Prose is written in flowing paragraphs; hard-wrapping at 80 columns
    // fights that and makes diffs noisy.
    "MD013": false,
    // Repeated headings are fine in changelogs and status pages, but keep
    // sibling headings distinct.
    "MD024": { "siblings_only": true }
  },
  // LICENSE is legal text in a fixed format, not documentation.
  "ignores": ["build/**", "LICENSE"]
}
